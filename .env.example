# Variables opcionales únicamente para pruebas locales. Nunca rellenar este
# archivo con credenciales reales ni subir un archivo `.env`.
ZAJUNA_TEST_DOCUMENT_TYPE=CC
ZAJUNA_TEST_USERNAME=
ZAJUNA_TEST_PASSWORD=
ZAJUNA_TEST_BASE_URL=https://zajuna.sena.edu.co

# La aplicación instalada no lee la contraseña desde un archivo `.env`:
# la guarda en el almacén seguro del sistema operativo.
